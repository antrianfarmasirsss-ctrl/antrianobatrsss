<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Antrian Depo Central Farmasi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    @keyframes marquee { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
    .animate-marquee { display: inline-block; white-space: nowrap; animation: marquee 20s linear infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
    .flash-update { animation: blink 0.6s ease-in-out 3; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col">

  <!-- NAVIGASI MODE (Otomatis hilang jika dibuka pasien lewat QR) -->
  <nav id="top-nav" class="bg-slate-900 text-white px-4 py-2 flex justify-between items-center shadow">
    <span class="font-bold text-sm">DEPO CENTRAL FARMASI</span>
    <div class="flex gap-2">
      <button onclick="switchMode('pasien')" id="btn-mode-pasien" class="bg-emerald-600 px-3 py-1 rounded text-xs font-bold">Tampilan TV / Pasien</button>
      <button onclick="bukaPanelPetugas()" id="btn-mode-petugas" class="bg-slate-700 px-3 py-1 rounded text-xs font-bold">Panel Petugas 🔒</button>
    </div>
  </nav>

  <!-- ==================== 1. TAMPILAN PASIEN & TV ==================== -->
  <main id="view-pasien" class="flex-1 max-w-5xl w-full mx-auto p-3 flex flex-col justify-between gap-3">
    <div>
      <h1 class="text-center font-extrabold text-slate-700 text-sm sm:text-xl mb-2 tracking-wide">ANTRIAN RESEP SELESAI (SIAP DIAMBIL)</h1>
      
      <!-- BARIS 1: 3 KOTAK SEJAJAR (COMPACT UNTUK HP) -->
      <div class="grid grid-cols-3 gap-2 sm:gap-4 mb-3">
        <!-- UMUM (A) -->
        <div id="card-A" class="bg-sky-600 text-white rounded-xl p-2 sm:p-5 text-center shadow">
          <div class="text-[10px] sm:text-sm font-bold tracking-wider uppercase opacity-90">UMUM (A)</div>
          <div id="disp-A" class="text-2xl sm:text-6xl font-black my-1 sm:my-3 tracking-tight">A-000</div>
          <div class="text-[9px] sm:text-xs opacity-80">Loket Penyerahan</div>
        </div>
        <!-- BPJS (B) -->
        <div id="card-B" class="bg-emerald-600 text-white rounded-xl p-2 sm:p-5 text-center shadow">
          <div class="text-[10px] sm:text-sm font-bold tracking-wider uppercase opacity-90">BPJS (B)</div>
          <div id="disp-B" class="text-2xl sm:text-6xl font-black my-1 sm:my-3 tracking-tight">B-000</div>
          <div class="text-[9px] sm:text-xs opacity-80">Loket Penyerahan</div>
        </div>
        <!-- PRIORITAS (C) -->
        <div id="card-C" class="bg-rose-600 text-white rounded-xl p-2 sm:p-5 text-center shadow">
          <div class="text-[10px] sm:text-sm font-bold tracking-wider uppercase opacity-90">PRIORITAS (C)</div>
          <div id="disp-C" class="text-2xl sm:text-6xl font-black my-1 sm:my-3 tracking-tight">C-000</div>
          <div class="text-[9px] sm:text-xs opacity-80">Loket Penyerahan</div>
        </div>
      </div>

      <!-- BARIS 2: OBAT SEDANG DIRACIK -->
      <div class="bg-white rounded-xl p-3 sm:p-4 shadow border-l-8 border-amber-500 mb-3">
        <h2 class="text-xs sm:text-base font-extrabold text-amber-700 mb-2">⏳ OBAT SEDANG DIRACIK</h2>
        <div id="list-racik" class="flex flex-wrap gap-2 min-h-[36px] items-center">
          <span class="text-xs text-slate-400 italic">Belum ada antrian racikan</span>
        </div>
      </div>

      <!-- BARIS 3: OBAT SEDANG DIKONFIRMASI -->
      <div class="bg-white rounded-xl p-3 sm:p-4 shadow border-l-8 border-purple-600">
        <h2 class="text-xs sm:text-base font-extrabold text-purple-700 mb-2">⚠️ OBAT SEDANG DIKONFIRMASI (Mohon ke Loket Informasi)</h2>
        <div id="list-konfirmasi" class="flex flex-wrap gap-2 min-h-[36px] items-center">
          <span class="text-xs text-slate-400 italic">Tidak ada antrian konfirmasi</span>
        </div>
      </div>
    </div>

    <!-- BARIS 4: QR CODE & RUNNING TEXT -->
    <footer class="bg-white rounded-xl p-3 shadow flex items-center gap-3 border border-slate-200 mt-2">
      <div id="qrcode" class="bg-white p-1 border rounded shrink-0"></div>
      <div class="overflow-hidden flex-1">
        <div class="text-xs font-bold text-slate-700">Scan QR Code untuk pantau antrian dari HP Anda</div>
        <div class="bg-slate-100 rounded py-1 px-2 mt-1 overflow-hidden">
          <div class="animate-marquee text-xs text-slate-600 font-medium">
            Selamat datang di Depo Central Farmasi • Mohon periksa kembali nama dan aturan pakai obat sebelum meninggalkan loket • Terima kasih atas kesabaran Anda.
          </div>
        </div>
      </div>
    </footer>
  </main>

  <!-- ==================== 2. PANEL KONTROL PETUGAS ==================== -->
  <section id="view-petugas" class="hidden flex-1 max-w-4xl w-full mx-auto p-3 space-y-4">
    <div class="bg-amber-50 border border-amber-200 text-amber-800 text-xs p-2.5 rounded-lg flex justify-between items-center">
      <span>Mode Petugas Aktif. Perubahan otomatis tampil di layar pasien.</span>
      <button onclick="resetSemua()" class="bg-red-600 text-white px-2.5 py-1 rounded font-bold">Reset Hari Baru</button>
    </div>

    <!-- KONTROL NEXT & UNDO (A, B, C) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- KONTROL A -->
      <div class="bg-white p-3 rounded-xl shadow border-t-4 border-sky-600">
        <div class="flex justify-between items-center mb-2">
          <span class="font-bold text-sky-700 text-sm">UMUM (A)</span>
          <span id="ctrl-disp-A" class="font-black text-xl text-slate-800">A-000</span>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <button onclick="ubahAntrian('A', -1)" class="bg-slate-200 hover:bg-slate-300 text-slate-800 py-2.5 rounded-lg font-bold text-sm">Undo (-1)</button>
          <button onclick="ubahAntrian('A', 1)" class="bg-sky-600 hover:bg-sky-700 text-white py-2.5 rounded-lg font-bold text-sm">Next (+1)</button>
        </div>
      </div>

      <!-- KONTROL B -->
      <div class="bg-white p-3 rounded-xl shadow border-t-4 border-emerald-600">
        <div class="flex justify-between items-center mb-2">
          <span class="font-bold text-emerald-700 text-sm">BPJS (B)</span>
          <span id="ctrl-disp-B" class="font-black text-xl text-slate-800">B-000</span>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <button onclick="ubahAntrian('B', -1)" class="bg-slate-200 hover:bg-slate-300 text-slate-800 py-2.5 rounded-lg font-bold text-sm">Undo (-1)</button>
          <button onclick="ubahAntrian('B', 1)" class="bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-lg font-bold text-sm">Next (+1)</button>
        </div>
      </div>

      <!-- KONTROL C -->
      <div class="bg-white p-3 rounded-xl shadow border-t-4 border-rose-600">
        <div class="flex justify-between items-center mb-2">
          <span class="font-bold text-rose-700 text-sm">PRIORITAS (C)</span>
          <span id="ctrl-disp-C" class="font-black text-xl text-slate-800">C-000</span>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <button onclick="ubahAntrian('C', -1)" class="bg-slate-200 hover:bg-slate-300 text-slate-800 py-2.5 rounded-lg font-bold text-sm">Undo (-1)</button>
          <button onclick="ubahAntrian('C', 1)" class="bg-rose-600 hover:bg-rose-700 text-white py-2.5 rounded-lg font-bold text-sm">Next (+1)</button>
        </div>
      </div>
    </div>

    <!-- KONTROL INPUT RACIKAN -->
    <div class="bg-white p-4 rounded-xl shadow border-l-4 border-amber-500">
      <h3 class="font-bold text-amber-700 text-sm mb-2">Tambah ke Obat Sedang Diracik</h3>
      <div class="flex gap-2 mb-3">
        <input type="text" id="input-racik" placeholder="Ketik nomor (misal: A5, B12, C1)" class="flex-1 border rounded-lg px-3 py-2 text-sm uppercase">
        <button onclick="tambahDaftar('racik')" class="bg-amber-500 text-white px-4 py-2 rounded-lg font-bold text-sm">Tambah</button>
      </div>
      <div id="ctrl-list-racik" class="flex flex-wrap gap-2"></div>
    </div>

    <!-- KONTROL INPUT KONFIRMASI -->
    <div class="bg-white p-4 rounded-xl shadow border-l-4 border-purple-600">
      <h3 class="font-bold text-purple-700 text-sm mb-2">Tambah ke Obat Sedang Dikonfirmasi</h3>
      <div class="flex gap-2 mb-3">
        <input type="text" id="input-konfirmasi" placeholder="Ketik nomor (misal: B9, A14)" class="flex-1 border rounded-lg px-3 py-2 text-sm uppercase">
        <button onclick="tambahDaftar('konfirmasi')" class="bg-purple-600 text-white px-4 py-2 rounded-lg font-bold text-sm">Tambah</button>
      </div>
      <div id="ctrl-list-konfirmasi" class="flex flex-wrap gap-2"></div>
    </div>
  </section>

  <!-- SCRIPT FIREBASE & LOGIKA APLIKASI -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getDatabase, ref, set, onValue } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

    // =================================================================
    // TEMPELKAN KODE firebaseConfig DARI FIREBASE ANDA DI BAWAH INI:
    const firebaseConfig = {

  apiKey: "AIzaSyA1BSj-haK-oGnCzB0Yhd3GW4T-5bA94kc",

  authDomain: "antrian-farmasi-depo.firebaseapp.com",

  databaseURL: "https://antrian-farmasi-depo-default-rtdb.asia-southeast1.firebasedatabase.app",

  projectId: "antrian-farmasi-depo",

  storageBucket: "antrian-farmasi-depo.firebasestorage.app",

  messagingSenderId: "294467361230",

  appId: "1:294467361230:web:d8ed0d5651bd339f8f339f"
};
    // =================================================================

    const PIN_PETUGAS = "1234"; // Ganti PIN petugas sesuai keinginan Anda

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const antrianRef = ref(db, 'depo_central');

    let state = { A: 0, B: 0, C: 0, racik: [], konfirmasi: [] };

    // Format nomor menjadi A-001
    function formatNomor(huruf, angka) {
      return `${huruf}-${String(angka).padStart(3, '0')}`;
    }

    // Normalisasi input teks bebas petugas (misal "b5" -> "B-005")
    function normalisasiKode(teks) {
      const bersih = teks.toUpperCase().replace(/[^A-Z0-9]/g, '');
      const match = bersih.match(/^([ABC])(\d+)$/);
      if (!match) return null;
      return `${match[1]}-${String(parseInt(match[2], 10)).padStart(3, '0')}`;
    }

    // Pengurutan khusus: A dulu, lalu C, lalu B, dari angka terkecil
    function urutkanAntrian(arr) {
      const prioritasHuruf = { 'A': 1, 'C': 2, 'B': 3 };
      return [...arr].sort((x, y) => {
        const [hx, nx] = x.split('-');
        const [hy, ny] = y.split('-');
        if (prioritasHuruf[hx] !== prioritasHuruf[hy]) {
          return prioritasHuruf[hx] - prioritasHuruf[hy];
        }
        return parseInt(nx, 10) - parseInt(ny, 10);
      });
    }

    // Dengarkan perubahan real-time dari Firebase
    onValue(antrianRef, (snapshot) => {
      const data = snapshot.val();
      if (data) {
        state = {
          A: data.A || 0,
          B: data.B || 0,
          C: data.C || 0,
          racik: data.racik || [],
          konfirmasi: data.konfirmasi || []
        };
      }
      renderTampilan();
    });

    function simpanKeFirebase() {
      set(antrianRef, state);
    }

    function renderTampilan() {
      ['A', 'B', 'C'].forEach(k => {
        const teks = formatNomor(k, state[k]);
        document.getElementById(`disp-${k}`).innerText = teks;
        document.getElementById(`ctrl-disp-${k}`).innerText = teks;
      });

      // Render Daftar Racik
      const racikTerurut = urutkanAntrian(state.racik);
      const elRacik = document.getElementById('list-racik');
      const ctrlRacik = document.getElementById('ctrl-list-racik');
      
      elRacik.innerHTML = racikTerurut.length
        ? racikTerurut.map(item => `<span class="bg-amber-100 text-amber-900 border border-amber-300 px-3 py-1 rounded-lg font-extrabold text-sm sm:text-lg">${item}</span>`).join('')
        : `<span class="text-xs text-slate-400 italic">Belum ada antrian racikan</span>`;

      ctrlRacik.innerHTML = racikTerurut.map(item => `
        <div class="flex items-center gap-1 bg-amber-100 border border-amber-300 px-2.5 py-1 rounded-lg text-xs font-bold">
          <span>${item}</span>
          <button onclick="selesaiRacik('${item}')" class="bg-emerald-600 text-white px-1.5 py-0.5 rounded ml-1">Selesai</button>
          <button onclick="hapusDaftar('racik', '${item}')" class="text-red-600 font-black px-1">✕</button>
        </div>
      `).join('');

      // Render Daftar Konfirmasi
      const konfTerurut = urutkanAntrian(state.konfirmasi);
      const elKonf = document.getElementById('list-konfirmasi');
      const ctrlKonf = document.getElementById('ctrl-list-konfirmasi');

      elKonf.innerHTML = konfTerurut.length
        ? konfTerurut.map(item => `<span class="bg-purple-100 text-purple-900 border border-purple-300 px-3 py-1 rounded-lg font-extrabold text-sm sm:text-lg">${item}</span>`).join('')
        : `<span class="text-xs text-slate-400 italic">Tidak ada antrian konfirmasi</span>`;

      ctrlKonf.innerHTML = konfTerurut.map(item => `
        <div class="flex items-center gap-1 bg-purple-100 border border-purple-300 px-2.5 py-1 rounded-lg text-xs font-bold">
          <span>${item}</span>
          <button onclick="hapusDaftar('konfirmasi', '${item}')" class="bg-red-600 text-white px-1.5 py-0.5 rounded ml-1">Hapus</button>
        </div>
      `).join('');
    }

    // Fungsi global agar bisa dipanggil tombol HTML
    window.ubahAntrian = (kategori, delta) => {
      state[kategori] = Math.max(0, state[kategori] + delta);
      simpanKeFirebase();
    };

    window.tambahDaftar = (jenis) => {
      const inputEl = document.getElementById(`input-${jenis}`);
      const kode = normalisasiKode(inputEl.value);
      if (!kode) {
        alert("Format salah! Gunakan awalan A, B, atau C diikuti angka (contoh: A5, B12, C2).");
        return;
      }
      if (!state[jenis].includes(kode)) {
        state[jenis].push(kode);
        simpanKeFirebase();
      }
      inputEl.value = '';
    };

    window.hapusDaftar = (jenis, kode) => {
      state[jenis] = state[jenis].filter(i => i !== kode);
      simpanKeFirebase();
    };

    window.selesaiRacik = (kode) => {
      state.racik = state.racik.filter(i => i !== kode);
      const [huruf, angkaStr] = kode.split('-');
      const angka = parseInt(angkaStr, 10);
      if (angka > state[huruf]) state[huruf] = angka;
      simpanKeFirebase();
    };

    window.resetSemua = () => {
      if (confirm("Yakin ingin mereset semua nomor antrian ke 000 untuk hari baru?")) {
        state = { A: 0, B: 0, C: 0, racik: [], konfirmasi: [] };
        simpanKeFirebase();
      }
    };

    window.switchMode = (mode) => {
      document.getElementById('view-pasien').classList.toggle('hidden', mode !== 'pasien');
      document.getElementById('view-petugas').classList.toggle('hidden', mode !== 'petugas');
    };

    window.bukaPanelPetugas = () => {
      const pin = prompt("Masukkan PIN Petugas Farmasi:");
      if (pin === PIN_PETUGAS) {
        switchMode('petugas');
      } else if (pin !== null) {
        alert("PIN Salah!");
      }
    };

    // Buat QR Code otomatis mengarah ke halaman khusus pasien
    const urlPasien = `${window.location.origin}${window.location.pathname}?view=pasien`;
    new QRCode(document.getElementById("qrcode"), { text: urlPasien, width: 64, height: 64 });

    // Sembunyikan navigasi atas jika dibuka dari scan QR pasien
    if (new URLSearchParams(window.location.search).get('view') === 'pasien') {
      document.getElementById('top-nav').classList.add('hidden');
    }
  </script>
</body>
</html>
